{
  "type": "object",
  "properties": {
    "top_story": {
      "type": "object",
      "description": "The day's most consequential network-device story. Usually the item with confirmed exploitation or the widest blast radius.",
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "description": "2-4 paragraphs: what happened, which devices, why it matters, what to do first."
        },
        "actions_now": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "title",
        "body",
        "actions_now"
      ],
      "additionalProperties": false
    },
    "ai_section": {
      "type": "object",
      "description": "AI and network devices. Only populate when a collected item genuinely concerns AI (AI-assisted attacks or discovery, AI/LLM integrations on network gear, prompt injection against network management). If nothing in today's items qualifies, set has_new_ai to false and leave the other fields empty - the site carries forward the last real one, dated.",
      "properties": {
        "has_new_ai": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "prevention_modern": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prevention_legacy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "has_new_ai",
        "title",
        "body",
        "prevention_modern",
        "prevention_legacy"
      ],
      "additionalProperties": false
    },
    "executive_summary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "relevance": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "watch",
              "drop"
            ]
          },
          "vendor": {
            "type": "string",
            "description": "Primary vendor, as the vendor writes it: Cisco, Fortinet, Palo Alto Networks, Juniper, F5, Citrix, Ivanti, Check Point, SonicWall, Sophos, HPE Aruba, Arista, MikroTik, Ubiquiti, Zyxel, NETGEAR, TP-Link, D-Link, WatchGuard, Barracuda, Extreme Networks. Use 'Multiple' for several, 'Unspecified' when none is named."
          },
          "device_types": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "firewall",
                "vpn-gateway",
                "router",
                "switch",
                "wireless",
                "load-balancer",
                "sdwan",
                "management-platform",
                "other"
              ]
            },
            "description": "Pick from the fixed list only. A firewall management server is 'management-platform'. A mail or web security appliance is 'other'."
          },
          "summary": {
            "type": "string",
            "description": "One sentence, under 200 characters: what happened and to which device, readable on its own. This is the line someone skims."
          },
          "affected": {
            "type": "string"
          },
          "what_happened": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "legacy_advice": {
            "type": "string"
          },
          "detection": {
            "type": "string"
          },
          "ai_angle": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "relevance",
          "vendor",
          "device_types",
          "summary",
          "affected",
          "what_happened",
          "why_it_matters",
          "actions",
          "legacy_advice",
          "detection",
          "ai_angle"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "top_story",
    "ai_section",
    "executive_summary",
    "items"
  ],
  "additionalProperties": false
}